generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id            String        @id @default(uuid())
  subdomain     String?       @unique
  name          String
  logoUrl       String?       @map("logo_url")
  phone         String?
  address       String?
  receiptFooter String        @default("Terima kasih telah berbelanja!") @map("receipt_footer")
  status        String        @default("trial") // trial | active | expired | suspended
  createdAt     DateTime      @default(now()) @map("created_at")

  users         User[]
  products      Product[]
  transactions  Transaction[]
  subscriptions Subscription[]
  roles         Role[]

  @@map("tenants")
}

model Role {
  id          String   @id @default(uuid())
  tenantId    String?  @map("tenant_id")
  name        String
  code        String
  description String?
  isSystem    Boolean  @default(false) @map("is_system")
  permissions String   @default("[]") // JSON array of permission strings
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  tenant      Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  users       User[]

  @@unique([tenantId, code])
  @@map("roles")
}

model User {
  id           String        @id @default(uuid())
  tenantId     String        @map("tenant_id")
  roleId       String?       @map("role_id")
  name         String
  email        String        @unique
  passwordHash String        @map("password_hash")
  role         String        @default("cashier") // 'owner' | 'cashier' | 'superadmin' | custom role code
  createdAt    DateTime      @default(now()) @map("created_at")

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customRole   Role?         @relation(fields: [roleId], references: [id], onDelete: SetNull)
  transactions Transaction[]

  @@map("users")
}

model Product {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  name      String
  price     Decimal  @db.Decimal(12, 2)
  stock     Int      @default(0)
  isService Boolean  @default(false) @map("is_service")
  createdAt DateTime @default(now()) @map("created_at")

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("products")
}

model Transaction {
  id            String            @id @default(uuid())
  tenantId      String            @map("tenant_id")
  userId        String            @map("user_id")
  customerName  String?           @default("Umum") @map("customer_name")
  customerPhone String?           @map("customer_phone")
  totalAmount   Decimal           @map("total_amount") @db.Decimal(12, 2)
  paymentMethod String            @default("cash") @map("payment_method") // 'cash' | 'qris' | 'transfer'
  status        String            @default("completed") // 'completed' | 'cancelled'
  createdAt     DateTime          @default(now()) @map("created_at")

  tenant        Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user          User              @relation(fields: [userId], references: [id])
  items         TransactionItem[]

  @@map("transactions")
}

model TransactionItem {
  id            String      @id @default(uuid())
  transactionId String      @map("transaction_id")
  productId     String      @map("product_id")
  productName   String      @map("product_name")
  price         Decimal     @db.Decimal(12, 2)
  qty           Int
  subtotal      Decimal     @db.Decimal(12, 2)

  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@map("transaction_items")
}

// 📦 Dynamic SaaS Plan Management (CRUD Paket Dinamis)
model Plan {
  id               String         @id @default(uuid())
  code             String         @unique // starter | pro | enterprise
  name             String         // e.g. "Pro Merchant White-Label"
  price            Decimal        @db.Decimal(12, 2)
  billingCycle     String         @default("monthly") @map("billing_cycle") // monthly | yearly
  maxCashiers      Int            @default(1) @map("max_cashiers") // Batas jumlah user kasir
  allowWhiteLabel  Boolean        @default(false) @map("allow_white_label")
  allowExportExcel Boolean        @default(false) @map("allow_export_excel")
  featuresJson     String         @map("features_json") // JSON Array daftar fitur paket
  isActive         Boolean        @default(true) @map("is_active")
  createdAt        DateTime       @default(now()) @map("created_at")

  subscriptions    Subscription[]

  @@map("plans")
}

// 💳 Tenant Subscription Lisensi Toko
model Subscription {
  id        String                @id @default(uuid())
  tenantId  String                @map("tenant_id")
  planId    String                @map("plan_id")
  status    String                @default("trial") // trial | active | expired | suspended
  startsAt  DateTime              @default(now()) @map("starts_at")
  expiresAt DateTime              @map("expires_at")
  autoRenew Boolean               @default(true) @map("auto_renew")
  createdAt DateTime              @default(now()) @map("created_at")

  tenant    Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan      Plan                  @relation(fields: [planId], references: [id])
  invoices  SubscriptionInvoice[]

  @@map("subscriptions")
}

// 🧾 Invoice Pembayaran Lisensi SaaS
model SubscriptionInvoice {
  id                 String       @id @default(uuid())
  subscriptionId     String       @map("subscription_id")
  amount             Decimal      @db.Decimal(12, 2)
  paymentGatewayTxId String?      @map("payment_gateway_tx_id")
  status             String       @default("unpaid") // unpaid | paid | failed
  paidAt             DateTime?    @map("paid_at")
  createdAt          DateTime     @default(now()) @map("created_at")

  subscription       Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@map("subscription_invoices")
}
