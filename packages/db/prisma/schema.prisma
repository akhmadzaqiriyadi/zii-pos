generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id            String        @id @default(uuid())
  name          String
  logoUrl       String?       @map("logo_url")
  phone         String?
  address       String?
  receiptFooter String        @default("Terima kasih telah berbelanja!") @map("receipt_footer")
  createdAt     DateTime      @default(now()) @map("created_at")

  users         User[]
  products      Product[]
  transactions  Transaction[]

  @@map("tenants")
}

model User {
  id           String        @id @default(uuid())
  tenantId     String        @map("tenant_id")
  name         String
  email        String        @unique
  passwordHash String        @map("password_hash")
  role         String        @default("cashier") // 'owner' | 'cashier'
  createdAt    DateTime      @default(now()) @map("created_at")

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@map("users")
}

model Product {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  name      String
  price     Decimal  @db.Decimal(12, 2)
  stock     Int      @default(0)
  isService Boolean  @default(false) @map("is_service")
  createdAt DateTime @default(now()) @map("created_at")

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("products")
}

model Transaction {
  id            String            @id @default(uuid())
  tenantId      String            @map("tenant_id")
  userId        String            @map("user_id")
  customerName  String?           @default("Umum") @map("customer_name")
  customerPhone String?           @map("customer_phone")
  totalAmount   Decimal           @map("total_amount") @db.Decimal(12, 2)
  paymentMethod String            @default("cash") @map("payment_method") // 'cash' | 'qris' | 'transfer'
  status        String            @default("completed") // 'completed' | 'cancelled'
  createdAt     DateTime          @default(now()) @map("created_at")

  tenant        Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user          User              @relation(fields: [userId], references: [id])
  items         TransactionItem[]

  @@map("transactions")
}

model TransactionItem {
  id            String      @id @default(uuid())
  transactionId String      @map("transaction_id")
  productId     String      @map("product_id")
  productName   String      @map("product_name")
  price         Decimal     @db.Decimal(12, 2)
  qty           Int
  subtotal      Decimal     @db.Decimal(12, 2)

  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@map("transaction_items")
}
